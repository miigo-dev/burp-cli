# Copy this file to secrets/.env and fill in real values. Never commit secrets/.env.

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Form Responses 1
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=secrets/service-account.json

# burp-cli invocation. If BURP_CLI_PATH doesn't exist, or the OS refuses to
# launch it (e.g. an Application Control / AppLocker policy blocking direct
# exe execution), the pipeline automatically falls back to `go run .` against
# BURP_CLI_SOURCE_DIR (requires Go on PATH; defaults to this repo's root).
BURP_CLI_PATH=C:\Development\burp-cli\burp-cli.exe
BURP_CLI_SOURCE_DIR=C:\Development\burp-cli
BURP_TARGET_HOST=127.0.0.1
BURP_TARGET_PORT=1337

# Output locations (relative to the pipeline/ directory unless absolute)
JOBS_DIR=jobs
LOG_DIR=logs

# A row stuck in "Processing" longer than this is treated as an abandoned/crashed
# run and reclaimed on the next poll.
MAX_ROW_RUNTIME_MINUTES=240

# Safety-net ceiling for the burp-cli subprocess itself (a real deep scan can run
# 30+ minutes; this is a dead-process backstop, not a real cap).
BURP_SUBPROCESS_TIMEOUT_MINUTES=180
